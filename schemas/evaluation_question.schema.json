  "required": [
    "question_id",
    "document_id",
    "company",
    "language",
    "category",
    "difficulty",
    "question",
    "reference_answer",
    "relevant_pages",
    "evidence",
    "relevant_chunk_ids",
    "answerable",
    "annotation_status",
    "split",
    "unit",
    "currency",
    "period",
    "scope",
    "calculation",
    "source_values",
    "context_annotation_status",
    "evidence_bundle_pages"
  ],
  "title": "EvaluationQuestion",
  "type": "object"
}
