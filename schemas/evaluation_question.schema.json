    },
    "rounding_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rounding Rule"
    },
    "scope": {
      "$ref": "#/$defs/FinancialScope"
    },
    "source_values": {
      "items": {
        "$ref": "#/$defs/SourceValue"
      },
      "title": "Source Values",
      "type": "array"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    }
