{
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Document Id",
      "type": "string"
    },
    "extraction_status": {
      "enum": [
        "extracted",
        "blank"
      ],
      "title": "Extraction Status",
      "type": "string"
    },
    "is_blank": {
      "title": "Is Blank",
      "type": "boolean"
    },
    "physical_page_number": {
      "exclusiveMinimum": 0,
      "title": "Physical Page Number",
      "type": "integer"
    },
    "source_filename": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Filename",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "source_filename",
    "source_sha256",
    "physical_page_number",
    "text",
    "is_blank",
    "extraction_status"
  ],
  "title": "PageRecord",
  "type": "object"
}
