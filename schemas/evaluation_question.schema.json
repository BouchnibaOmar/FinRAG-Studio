          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "interpretation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Interpretation",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "value": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "currency",
        "interpretation"
      ],
      "title": "CalculatedResult",
      "type": "object"
    },
    "Evidence": {
