  "additionalProperties": false,
  "properties": {
    "annotation_status": {
      "enum": [
        "candidate",
        "verified"
      ],
      "title": "Annotation Status",
      "type": "string"
    },
    "answerable": {
      "title": "Answerable",
      "type": "boolean"
    },
    "calculated_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalculatedResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
