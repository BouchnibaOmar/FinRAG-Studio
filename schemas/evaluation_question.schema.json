    "operation": {
      "anyOf": [
        {
          "const": "subtract",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation"
    },
    "period": {
      "$ref": "#/$defs/FinancialPeriod"
    },
    "possible_confusion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Possible Confusion"
    },
    "question": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Question",
      "type": "string"
    },
    "question_id": {
      "pattern": "^finrag_v1_[a-z]+_[0-9]{2}$",
      "title": "Question Id",
      "type": "string"
    },
    "reason_unanswerable": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Unanswerable"
    },
    "reference_answer": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reference Answer",
      "type": "string"
    },
    "relevant_chunk_ids": {
      "items": {
        "type": "string"
      },
      "title": "Relevant Chunk Ids",
      "type": "array"
    },
    "relevant_pages": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "title": "Relevant Pages",
      "type": "array"
    },
    "requested_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
