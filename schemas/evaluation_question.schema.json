      "type": "string"
    },
    "company": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Company",
      "type": "string"
    },
    "context_annotation_status": {
      "const": "candidate",
      "title": "Context Annotation Status",
      "type": "string"
    },
    "corpus_years": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Years"
    },
    "currency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Currency"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "document_id": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Document Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_bundle_pages": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "title": "Evidence Bundle Pages",
      "type": "array"
    },
    "language": {
      "enum": [
        "fr",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "operand_1": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
