    "calculation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Calculation"
    },
    "category": {
      "enum": [
        "factual",
        "numerical",
        "comparative",
        "definition_policy",
        "unanswerable"
